  </diagram>
  <diagram id="governance" name="3 - PII defense in depth">
    <mxGraphModel dx="1500" dy="1000" grid="1" gridSize="10" page="1" pageScale="1" pageWidth="1500" pageHeight="1000">
      <root>
        <mxCell id="0"/><mxCell id="1" parent="0"/>
        <mxCell id="title" value="PII / Different controls solve different problems" style="text;html=0;align=left;fontSize=30;fontStyle=1;fontColor=#142B40;" vertex="1" parent="1"><mxGeometry x="40" y="25" width="1400" height="60" as="geometry"/></mxCell>
        <mxCell id="legend" value="Solid blue = implemented Chatty path, including Foundry PII input and output blocking. Dashed gray = proposed enterprise integrations, NOT deployed." style="text;html=0;align=left;whiteSpace=wrap;fontSize=15;fontColor=#506174;" vertex="1" parent="1"><mxGeometry x="40" y="95" width="1400" height="50" as="geometry"/></mxCell>
        <mxCell id="lake" value="Microsoft Fabric / OneLake&#xa;PROPOSED&#xa;&#xa;Classify source data&#xa;Restricted raw zone&#xa;Curated de-identified zone&#xa;Workspace/item + OneLake security&#xa;Rows/columns/folders as supported" style="rounded=1;dashed=1;whiteSpace=wrap;html=0;fillColor=#F3F4F6;strokeColor=#8494A5;fontColor=#142B40;fontSize=15;" vertex="1" parent="1"><mxGeometry x="40" y="230" width="240" height="210" as="geometry"/></mxCell>
        <mxCell id="retrieval" value="Authorized retrieval / ingestion&#xa;PROPOSED for real enterprise data&#xa;&#xa;Enforce caller authorization&#xa;Honor label/rights policies&#xa;Minimize + redact before indexing&#xa;Embeddings are model calls too" style="rounded=1;dashed=1;whiteSpace=wrap;html=0;fillColor=#F3F4F6;strokeColor=#8494A5;fontColor=#142B40;fontSize=15;" vertex="1" parent="1"><mxGeometry x="330" y="230" width="240" height="210" as="geometry"/></mxCell>
        <mxCell id="app" value="Chatty trusted application&#xa;IMPLEMENTED&#xa;&#xa;Azure AI Language screening&#xa;Questions + context + history&#xa;Fail closed / masked text only&#xa;Synthetic references today" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#DDEDF8;strokeColor=#3672A1;fontColor=#142B40;fontSize=15;" vertex="1" parent="1"><mxGeometry x="620" y="230" width="240" height="210" as="geometry"/></mxCell>
        <mxCell id="model" value="Foundry comparison / IMPLEMENTED&#xa;&#xa;Two pinned prompt agents/models&#xa;Identical screened input + prompt&#xa;Guarded: 46 INPUT PII blocks&#xa;Baseline: NO custom PII controls&#xa;Both retain harm/attack controls&#xa;No tools / streaming / history&#xa;Blocking does not redact input" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#142B40;strokeColor=#142B40;fontColor=#FFFFFF;fontSize=15;" vertex="1" parent="1"><mxGeometry x="910" y="230" width="240" height="210" as="geometry"/></mxCell>
        <mxCell id="output" value="Output controls / IMPLEMENTED&#xa;&#xa;Guarded: 45 PII/secret blocks&#xa;Name Protection: detect-only&#xa;Baseline: NO custom PII controls&#xa;Same direct email probe:&#xa;guarded BLOCKS / baseline RETURNS&#xa;&#xa;BOTH app outputs: Language screening&#xa;+ citations before display" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#DDEDF8;strokeColor=#3672A1;fontColor=#142B40;fontSize=15;" vertex="1" parent="1"><mxGeometry x="1200" y="230" width="260" height="210" as="geometry"/></mxCell>
        <mxCell id="purview" value="Microsoft Purview / PROPOSED&#xa;&#xa;Catalog, ownership, classification, sensitivity labels, lineage&#xa;AI interaction audit / DSPM and explicit DLP API enforcement&#xa;Native audit opt-in may transfer and retain full prompts/responses.&#xa;Review permissions, licensing, scope, retention, and residency first." style="rounded=1;dashed=1;whiteSpace=wrap;html=0;fillColor=#F3F4F6;strokeColor=#8494A5;fontColor=#142B40;fontSize=15;" vertex="1" parent="1"><mxGeometry x="40" y="565" width="650" height="170" as="geometry"/></mxCell>
        <mxCell id="defender" value="Defender for Cloud / AI Services + Defender XDR / PROPOSED&#xa;&#xa;Threat detections, posture review, security alert correlation&#xa;Not an inline PII scrubber or guarantee of prevention&#xa;Prompt-evidence and Purview data-sharing settings require review&#xa;No subscription-wide plan or data-sharing setting enabled by this work." style="rounded=1;dashed=1;whiteSpace=wrap;html=0;fillColor=#F3F4F6;strokeColor=#8494A5;fontColor=#142B40;fontSize=15;" vertex="1" parent="1"><mxGeometry x="760" y="565" width="700" height="170" as="geometry"/></mxCell>
        <mxCell id="limits" value="No real borrower data in the POC. Labels and catalog entries are not redaction. Defender alerts are not inline prevention.&#xa;An app managed identity must not erase the end user's source permissions. Adding a RAG connector requires an explicit authorization design.&#xa;Operational logging stays content-free; richer audit/telemetry is a separate approved data-processing path." style="text;html=0;align=left;whiteSpace=wrap;fontSize=16;fontColor=#506174;" vertex="1" parent="1"><mxGeometry x="40" y="810" width="1400" height="100" as="geometry"/></mxCell>
        <mxCell id="g1" value="Authorized curated data" style="edgeStyle=orthogonalEdgeStyle;endArrow=open;dashed=1;html=0;fontSize=12;" edge="1" source="lake" target="retrieval" parent="1"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="g2" value="Re-screen on use" style="edgeStyle=orthogonalEdgeStyle;endArrow=open;dashed=1;html=0;fontSize=12;" edge="1" source="retrieval" target="app" parent="1"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="g3" value="Screened text" style="edgeStyle=orthogonalEdgeStyle;endArrow=block;strokeColor=#3672A1;strokeWidth=2;html=0;fontSize=12;" edge="1" source="app" target="model" parent="1"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="g4" value="Buffered response" style="edgeStyle=orthogonalEdgeStyle;endArrow=block;strokeColor=#3672A1;strokeWidth=2;html=0;fontSize=12;" edge="1" source="model" target="output" parent="1"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="g5" value="Governance policies" style="edgeStyle=orthogonalEdgeStyle;endArrow=open;dashed=1;html=0;fontSize=12;" edge="1" source="purview" target="lake" parent="1"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="g6" value="Explicit integration / audit opt-in" style="edgeStyle=orthogonalEdgeStyle;endArrow=open;dashed=1;html=0;fontSize=12;" edge="1" source="purview" target="app" parent="1"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="g7" value="Threat signals / not raw operational logs" style="edgeStyle=orthogonalEdgeStyle;endArrow=open;dashed=1;html=0;fontSize=12;" edge="1" source="model" target="defender" parent="1"><mxGeometry relative="1" as="geometry"/></mxCell>
      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
