        <mxCell id="title" value="CHATTY / Private Azure infrastructure" style="text;html=0;align=left;fontSize=30;fontStyle=1;fontColor=#142B40;" vertex="1" parent="1"><mxGeometry x="40" y="20" width="1300" height="60" as="geometry"/></mxCell>
        <mxCell id="scope" value="West US 3 / rg-chatty-westus3-demo / subscription 00000000-0000-0000-0000-000000000001" style="text;html=0;align=left;fontSize=16;fontColor=#506174;" vertex="1" parent="1"><mxGeometry x="40" y="85" width="1450" height="40" as="geometry"/></mxCell>
        <mxCell id="vnet" value="vnet-chatty-demo0001 / 10.243.0.0/16 / NSGs on subnets" style="swimlane;html=0;startSize=40;fillColor=#DDEDF8;swimlaneFillColor=#F8FAFC;strokeColor=#3672A1;fontSize=17;fontStyle=1;fontColor=#142B40;" vertex="1" parent="1"><mxGeometry x="260" y="170" width="930" height="680" as="geometry"/></mxCell>
        <mxCell id="user" value="Authorized employee&#xa;Local browser" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#FFFFFF;strokeColor=#142B40;fontColor=#142B40;fontSize=15;" vertex="1" parent="1"><mxGeometry x="30" y="235" width="180" height="90" as="geometry"/></mxCell>
        <mxCell id="entra" value="Microsoft Entra ID&#xa;Single tenant / MFA policy&#xa;Chatty.User + member claim&#xa;Managed identities + RBAC" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#FFFFFF;strokeColor=#3672A1;fontColor=#142B40;fontSize=15;" vertex="1" parent="1"><mxGeometry x="30" y="465" width="190" height="150" as="geometry"/></mxCell>
        <mxCell id="bastion" value="AzureBastionSubnet&#xa;10.243.4.0/26&#xa;&#xa;bas-chatty-demo0001&#xa;Standard Bastion + public IP&#xa;TLS ingress for remote access" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#FFFFFF;strokeColor=#8599AB;fontSize=14;fontColor=#142B40;" vertex="1" parent="1"><mxGeometry x="300" y="240" width="235" height="160" as="geometry"/></mxCell>
        <mxCell id="vm" value="Jump subnet / 10.243.3.0/27&#xa;vm-chatty-jump / 10.243.3.4&#xa;Windows Server 2022 / OS disk&#xa;Entra login + MDE extension&#xa;Browser uses private DNS&#xa;No VM public IP" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#FFFFFF;strokeColor=#8599AB;fontSize=14;fontColor=#142B40;" vertex="1" parent="1"><mxGeometry x="590" y="240" width="250" height="160" as="geometry"/></mxCell>
        <mxCell id="nat" value="NAT gateway + outbound IP&#xa;Jump-subnet egress&#xa;NOT an egress firewall" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#FFF1BE;strokeColor=#A87900;fontSize=14;fontColor=#493900;" vertex="1" parent="1"><mxGeometry x="890" y="245" width="250" height="100" as="geometry"/></mxCell>
        <mxCell id="pe" value="Private endpoints / 10.243.1.0/24&#xa;&#xa;App + SCM private endpoint&#xa;Foundry private endpoint&#xa;Language private endpoint&#xa;Provider-created NICs" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#DDEDF8;strokeColor=#3672A1;fontSize=14;fontColor=#142B40;" vertex="1" parent="1"><mxGeometry x="590" y="470" width="250" height="165" as="geometry"/></mxCell>
        <mxCell id="integration" value="Web integration / 10.243.2.0/26&#xa;App Service outbound into VNet&#xa;Separate from inbound private endpoint" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#FFFFFF;strokeColor=#8599AB;fontSize=14;fontColor=#142B40;" vertex="1" parent="1"><mxGeometry x="890" y="475" width="250" height="115" as="geometry"/></mxCell>
        <mxCell id="agents" value="Agents subnet / 10.243.0.0/24&#xa;Foundry network injection&#xa;Capability host: chatty-agents&#xa;Ordinary prompt agent, not hosted" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#FFFFFF;strokeColor=#8599AB;fontSize=14;fontColor=#142B40;" vertex="1" parent="1"><mxGeometry x="300" y="470" width="235" height="165" as="geometry"/></mxCell>
        <mxCell id="dns" value="Private DNS / VNet links&#xa;privatelink.azurewebsites.net (app + SCM)&#xa;privatelink.cognitiveservices.azure.com&#xa;privatelink.services.ai.azure.com / privatelink.openai.azure.com" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#FFFFFF;strokeColor=#8599AB;fontSize=14;fontColor=#142B40;" vertex="1" parent="1"><mxGeometry x="300" y="690" width="840" height="105" as="geometry"/></mxCell>
        <mxCell id="app" value="App Service / Linux / .NET 10&#xa;chatty-web-demo0001&#xa;P0v3 plan / managed identity&#xa;Public access disabled&#xa;Content-free application logs" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#142B40;strokeColor=#142B40;fontColor=#FFFFFF;fontSize=15;" vertex="1" parent="1"><mxGeometry x="1250" y="235" width="300" height="160" as="geometry"/></mxCell>
        <mxCell id="language" value="Azure AI Language / S&#xa;chatty-language-demo0001&#xa;PII screening / key auth disabled&#xa;Public access disabled" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#DDEDF8;strokeColor=#3672A1;fontSize=15;fontColor=#142B40;" vertex="1" parent="1"><mxGeometry x="1250" y="465" width="300" height="135" as="geometry"/></mxCell>
        <mxCell id="foundry" value="Foundry account / project chatty&#xa;chatty-ai-demo0001&#xa;Pinned agents chatty + chatty-no-pii&#xa;gpt-5-mini + gpt-5-mini-no-pii&#xa;Same version / US DataZoneStandard / 10&#xa;ChattyStrict vs ChattyWithoutPii&#xa;Public + key access disabled" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#FFDC52;strokeColor=#142B40;fontSize=14;fontColor=#142B40;" vertex="1" parent="1"><mxGeometry x="1250" y="675" width="300" height="160" as="geometry"/></mxCell>
        <mxCell id="notes" value="Solid arrows = access/data paths; dashed arrows = identity/configuration. Azure PaaS services are outside the customer subnet.&#xa;Private endpoints provide inbound access; VNet integration provides App Service outbound connectivity.&#xa;West US 3 hosts the resources. DataZoneStandard model inference is US data-zone scoped, not guaranteed to execute in West US 3.&#xa;All solution resources use securitycontrol=ignore and costcontrol=ignore tags; tags do not configure security controls." style="text;html=0;align=left;fontSize=15;fontColor=#506174;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="40" y="900" width="1500" height="125" as="geometry"/></mxCell>
        <mxCell id="e1" value="HTTPS / Bastion" style="edgeStyle=orthogonalEdgeStyle;endArrow=block;html=0;fontSize=12;" edge="1" source="user" target="bastion" parent="1"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e2" value="Private RDP" style="edgeStyle=orthogonalEdgeStyle;endArrow=block;html=0;fontSize=12;" edge="1" source="bastion" target="vm" parent="1"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e3" value="Outbound" style="edgeStyle=orthogonalEdgeStyle;endArrow=block;html=0;fontSize=12;" edge="1" source="vm" target="nat" parent="1"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e4" value="Private HTTPS" style="edgeStyle=orthogonalEdgeStyle;endArrow=block;html=0;fontSize=12;" edge="1" source="vm" target="pe" parent="1"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e5" value="App + SCM" style="edgeStyle=orthogonalEdgeStyle;endArrow=block;html=0;fontSize=12;exitX=1;exitY=0.1;entryX=0;entryY=0.5;" edge="1" source="pe" target="app" parent="1"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e6" value="Private service access" style="edgeStyle=orthogonalEdgeStyle;endArrow=block;html=0;fontSize=12;exitX=1;exitY=0.5;" edge="1" source="pe" target="language" parent="1"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e7" value="Private service access" style="edgeStyle=orthogonalEdgeStyle;endArrow=block;html=0;fontSize=12;exitX=1;exitY=0.8;" edge="1" source="pe" target="foundry" parent="1"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e8" value="Outbound" style="edgeStyle=orthogonalEdgeStyle;endArrow=block;html=0;fontSize=12;" edge="1" source="app" target="integration" parent="1"><mxGeometry relative="1" as="geometry"/></mxCell>
