<mxfile host="app.diagrams.net" version="24.7.17">
  <diagram id="software" name="1 - Software architecture">
    <mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" page="1" pageScale="1" pageWidth="1400" pageHeight="1000">
      <root>
        <mxCell id="0"/><mxCell id="1" parent="0"/>
        <mxCell id="title" value="CHATTY / Follow the question" style="text;html=0;align=left;fontSize=30;fontStyle=1;fontColor=#142B40;" vertex="1" parent="1"><mxGeometry x="40" y="30" width="1000" height="50" as="geometry"/></mxCell>
        <mxCell id="subtitle" value="Current POC comparison. Solid arrows = runtime flow; dashed = configuration or legacy-only path. Synthetic data only." style="text;html=0;align=left;fontSize=15;fontColor=#506174;" vertex="1" parent="1"><mxGeometry x="40" y="85" width="1250" height="30" as="geometry"/></mxCell>
        <mxCell id="appBoundary" value="Trusted ASP.NET Core application / App Service managed identity / employee-only access" style="swimlane;html=0;startSize=40;fillColor=#F0F5F9;swimlaneFillColor=#F8FAFC;strokeColor=#8599AB;fontColor=#142B40;fontSize=16;rounded=1;" vertex="1" parent="1"><mxGeometry x="270" y="150" width="820" height="590" as="geometry"/></mxCell>
        <mxCell id="browser" value="Browser on jump VM&#xa;&#xa;Synthetic question&#xa;Raw text briefly in composer&#xa;Exact screened-question preview&#xa;No browser storage" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#FFFFFF;strokeColor=#142B40;fontColor=#142B40;fontSize=15;" vertex="1" parent="1"><mxGeometry x="30" y="240" width="200" height="180" as="geometry"/></mxCell>
        <mxCell id="auth" value="Program.cs&#xa;Entra employee policy&#xa;CSRF + rate limit&#xa;Content-free operational logs" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#FFFFFF;strokeColor=#8599AB;fontColor=#142B40;fontSize=14;" vertex="1" parent="1"><mxGeometry x="310" y="220" width="230" height="110" as="geometry"/></mxCell>
        <mxCell id="chat" value="ChatService.cs / CompareAsync&#xa;&#xa;1 Screen question + references ONCE&#xa;2 Send identical values to BOTH agents&#xa;3 Independently screen each answer&#xa;4 Validate citations / separate outcomes" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#FFDC52;strokeColor=#142B40;fontColor=#142B40;fontSize=16;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="600" y="210" width="430" height="160" as="geometry"/></mxCell>
        <mxCell id="pii" value="AzurePiiScreen / PiiScreen.cs&#xa;Azure AI Language&#xa;&#xa;Raw text goes to this service.&#xa;Errors/warnings stop the request.&#xa;Service content logging disabled." style="rounded=1;whiteSpace=wrap;html=0;fillColor=#DDEDF8;strokeColor=#3672A1;fontColor=#142B40;fontSize=14;" vertex="1" parent="1"><mxGeometry x="600" y="430" width="230" height="160" as="geometry"/></mxCell>
        <mxCell id="knowledge" value="SyntheticKnowledge / Knowledge.cs&#xa;Knowledge/synthetic.json&#xa;3 original synthetic references&#xa;No match = no model call" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#FFFFFF;strokeColor=#8599AB;fontColor=#142B40;fontSize=14;" vertex="1" parent="1"><mxGeometry x="310" y="420" width="230" height="120" as="geometry"/></mxCell>
        <mxCell id="history" value="ConversationStore / LEGACY ONLY&#xa;Used by /api/chat, not /api/compare&#xa;Screened turns / owner-bound&#xa;20 min / 6 answers / re-screen replay" style="rounded=1;dashed=1;whiteSpace=wrap;html=0;fillColor=#FFFFFF;strokeColor=#8599AB;fontColor=#142B40;fontSize=14;" vertex="1" parent="1"><mxGeometry x="310" y="580" width="230" height="110" as="geometry"/></mxCell>
        <mxCell id="client" value="FoundryPromptAgent.cs&#xa;Responses API&#xa;Pinned name + version&#xa;store=false / no streaming/tools" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#FFFFFF;strokeColor=#8599AB;fontColor=#142B40;fontSize=14;" vertex="1" parent="1"><mxGeometry x="860" y="430" width="200" height="160" as="geometry"/></mxCell>
        <mxCell id="foundry" value="Guarded prompt agent: chatty&#xa;Deployment: gpt-5-mini&#xa;&#xa;Agent/definition.json&#xa;Shared Agent/instructions.md&#xa;No tools / no policy override&#xa;Independent response + log" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#142B40;strokeColor=#142B40;fontColor=#FFFFFF;fontSize=15;" vertex="1" parent="1"><mxGeometry x="1140" y="235" width="220" height="190" as="geometry"/></mxCell>
        <mxCell id="baseline" value="Baseline: chatty-no-pii&#xa;Deployment: gpt-5-mini-no-pii&#xa;Agent/baseline-definition.json&#xa;SAME Agent/instructions.md&#xa;ChattyWithoutPii: 9 safety controls&#xa;NO custom PII controls&#xa;Independent response + log" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#FFFFFF;strokeColor=#142B40;fontColor=#142B40;fontSize=14;" vertex="1" parent="1"><mxGeometry x="1130" y="685" width="240" height="170" as="geometry"/></mxCell>
        <mxCell id="policy" value="Foundry ChattyStrict / 101 controls&#xa;9 harm + prompt-attack controls&#xa;INPUT: 46 PII/secret blocks&#xa;OUTPUT: 45 PII/secret blocks&#xa;Output Name: ANNOTATING&#xa;Synthetic email input blocked (400).&#xa;App still redacts input AND output.&#xa;Blocking is not input redaction." style="rounded=1;whiteSpace=wrap;html=0;fillColor=#DDEDF8;strokeColor=#3672A1;fontColor=#142B40;fontSize=14;" vertex="1" parent="1"><mxGeometry x="1130" y="475" width="240" height="170" as="geometry"/></mxCell>
        <mxCell id="logs" value="POST /api/compare: shared screening log + trace ID; two separately labeled response/log arms.&#xa;Both keep input/output Language redaction, citations, baseline safety and private employee access.&#xa;A failed/withheld arm never releases partial text or hides a successful other arm.&#xa;Logs: stages/counts/durations/codes only, never prompts, answers, tokens or identity claims." style="text;html=0;align=left;fontSize=15;fontColor=#506174;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="280" y="780" width="800" height="110" as="geometry"/></mxCell>
        <mxCell id="a1" value="HTTPS + cookie / screened reply" style="edgeStyle=orthogonalEdgeStyle;endArrow=block;startArrow=block;html=0;fontSize=12;" edge="1" source="browser" target="auth" parent="1"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="a2" style="edgeStyle=orthogonalEdgeStyle;endArrow=block;" edge="1" source="auth" target="chat" parent="1"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="a3" value="redact / masked text" style="edgeStyle=orthogonalEdgeStyle;endArrow=block;startArrow=block;html=0;fontSize=12;" edge="1" source="chat" target="pii" parent="1"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="a4" value="screened query" style="edgeStyle=orthogonalEdgeStyle;endArrow=block;startArrow=block;html=0;fontSize=12;" edge="1" source="chat" target="knowledge" parent="1"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="a5" value="legacy SendAsync only" style="edgeStyle=orthogonalEdgeStyle;dashed=1;endArrow=block;startArrow=block;html=0;fontSize=12;" edge="1" source="chat" target="history" parent="1"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="a6" value="screened messages only" style="edgeStyle=orthogonalEdgeStyle;endArrow=block;html=0;fontSize=12;" edge="1" source="chat" target="client" parent="1"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="a7" value="private HTTPS + Entra token" style="edgeStyle=orthogonalEdgeStyle;endArrow=block;startArrow=block;html=0;fontSize=12;" edge="1" source="client" target="foundry" parent="1"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="a9" value="identical screened input / separate call" style="edgeStyle=orthogonalEdgeStyle;endArrow=block;startArrow=block;html=0;fontSize=12;" edge="1" source="client" target="baseline" parent="1"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="a8" value="model policy inherited when no agent override" style="edgeStyle=orthogonalEdgeStyle;endArrow=open;dashed=1;html=0;fontSize=12;" edge="1" source="policy" target="foundry" parent="1"><mxGeometry relative="1" as="geometry"/></mxCell>
      </root>
    </mxGraphModel>
  </diagram>
  <diagram id="azure" name="2 - Azure infrastructure">
